# Guestbook storage. Without these the guestbook section does not render in
# production, and falls back to in-memory storage in development so the form
# is testable before any account exists.
#
# Vercel's Upstash integration (Storage -> Create -> Upstash for Redis) injects
# the KV_REST_API_* pair into the project by itself, so there is usually
# nothing to paste. A database created directly at upstash.com gives the
# UPSTASH_REDIS_REST_* pair instead; either is accepted.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional. Salts the hash used as the per-visitor rate-limit key, so the
# store never holds anything that identifies a visitor. Any random string.
GUESTBOOK_SALT=

# Optional. Overrides the canonical origin used in metadata and the sitemap.
SITE_URL=
